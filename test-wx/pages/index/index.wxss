.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.section {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.value {
  font-size: 24rpx;
  color: #07c160;
  word-break: break-all;
}

button {
  width: 80%;
  margin: 20rpx 0;
}

.result {
  width: 100%;
  margin-top: 40rpx;
  padding: 30rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  min-height: 200rpx;
}

.result text {
  font-size: 28rpx;
  color: #333;
  white-space: pre-line;
}
