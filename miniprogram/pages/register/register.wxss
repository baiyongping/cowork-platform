/* pages/register/register.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
}

/* 授权页面 */
.auth-page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 注册表单页面 */
.register-page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 授权说明 */
.auth-info {
  width: 100%;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
  backdrop-filter: blur(10px);
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.info-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 用户信息 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  width: 100%;
  backdrop-filter: blur(10px);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.nickname {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.login-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 授权区域 */
.auth-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.auth-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(245, 87, 108, 0.4);
  border: none;
}

.auth-btn::after {
  border: none;
}

.auth-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

/* 表单区域 */
.form-section {
  width: 100%;
}

/* 🎨 头像选择区域 */
.avatar-section {
  width: 100%;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.avatar-button {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background: transparent;
  border: none;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-button::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-sizing: border-box;
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(67, 233, 123, 0.4);
  border: none;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: none;
}

/* 邀请码信息 */
.invitation-info-bottom {
  margin-top: 60rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.5;
}
