/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: #F8F9FA;
  padding-bottom: 20rpx;
}

/* ========== 顶部统计区域 - 非对称布局 ========== */
.stats-section {
  display: flex;
  padding: 32rpx 24rpx;
  gap: 16rpx;
}

.stat-card-large {
  flex: 1.3;
  background: linear-gradient(135deg, #FF6B35 0%, #F39C12 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.25);
}

.stat-card-large::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.stat-number {
  font-size: 96rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  letter-spacing: -2rpx;
}

.stat-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
  font-weight: 500;
}

.stat-badge {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.stat-card-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-card-small {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-number-small {
  font-size: 56rpx;
  font-weight: bold;
  color: #2C3E50;
  line-height: 1;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.stat-label-small {
  font-size: 24rpx;
  color: #7A7E83;
  margin-top: 12rpx;
}

/* ========== 内容区块 ========== */
.section {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #FF6B35;
  padding-left: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  font-family: 'PingFang SC', sans-serif;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

/* ========== 任务列表 - 交错式卡片 ========== */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border-left: 4rpx solid #FF6B35;
  position: relative;
}

.task-main {
  flex: 1;
}

.task-name {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.task-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #7A7E83;
}

.task-owner::before {
  content: '👤 ';
}

.task-date::before {
  content: '📅 ';
}

.task-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.task-badge-pending {
  background: #FFF3E0;
  color: #F39C12;
}

.task-badge-in-progress {
  background: #E3F2FD;
  color: #2196F3;
}

.task-badge-completed {
  background: #E8F5E9;
  color: #4CAF50;
}

/* ========== 商机列表 ========== */
.opportunity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.opportunity-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFBF5 0%, #FFF8F0 100%);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border-left: 4rpx solid #F39C12;
}

.opportunity-main {
  flex: 1;
}

.opportunity-name {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.opportunity-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.opportunity-owner {
  color: #7A7E83;
}

.opportunity-amount {
  color: #FF6B35;
  font-weight: 600;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.opportunity-stage {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(243, 156, 18, 0.15);
  color: #F39C12;
  white-space: nowrap;
}

/* ========== 空状态 ========== */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #B0B5BA;
}
