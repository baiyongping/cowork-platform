/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  color: white;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 卡片基础样式 */
.status-card,
.user-card,
.logs-card,
.info-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 状态卡片 */
.status-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.status-content {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.status-content text:first-child {
  color: #666;
  min-width: 120rpx;
}

.status-step {
  color: #4CAF50;
  font-weight: bold;
}

.openid,
.code {
  color: #2196F3;
  font-family: monospace;
  font-size: 24rpx;
  word-break: break-all;
  flex: 1;
}

/* 用户信息卡片 */
.user-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 20rpx;
  border: 4rpx solid #f0f0f0;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.user-meta {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

/* 操作按钮区域 */
.actions {
  margin-bottom: 30rpx;
}

.btn-primary,
.btn-secondary,
.btn-info,
.btn-warning {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border: 2rpx solid #ddd;
}

.btn-info {
  background-color: #E3F2FD;
  color: #1976D2;
  border: 2rpx solid #90CAF9;
}

.btn-warning {
  background-color: #FFF3E0;
  color: #F57C00;
  border: 2rpx solid #FFCC80;
}

.step-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.step-actions .btn-secondary {
  flex: 1;
  margin-bottom: 0;
}

/* 日志卡片 */
.logs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.logs-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.btn-small {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
}

.logs-content {
  height: 300rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.log-item {
  display: block;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 10rpx;
  word-break: break-all;
  font-family: monospace;
}

.log-empty {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-top: 100rpx;
}

/* 信息卡片 */
.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

/* 按钮状态 */
button:disabled {
  opacity: 0.5;
  background-color: #f0f0f0 !important;
  color: #999 !important;
}

/* 加载状态 */
button[loading] {
  opacity: 0.7;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .user-info {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .avatar {
    margin-right: 0;
    margin-bottom: 20rpx;
  }
  
  .step-actions {
    flex-direction: column;
  }
}