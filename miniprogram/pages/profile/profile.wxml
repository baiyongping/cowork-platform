<!--pages/profile/profile.wxml-->
<view class="container">
  <view class="profile-header">
    <view class="avatar-section">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}"></image>
      <view class="user-name">{{userInfo.name || '未登录'}}</view>
      <view class="user-role">{{userInfo.role || '员工'}}</view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item">
      <text class="menu-label">我的任务</text>
      <text class="menu-value">查看 ></text>
    </view>
    <view class="menu-item">
      <text class="menu-label">我的商机</text>
      <text class="menu-value">查看 ></text>
    </view>
    <view class="menu-item">
      <text class="menu-label">我的项目</text>
      <text class="menu-value">查看 ></text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item">
      <text class="menu-label">设置</text>
      <text class="menu-value">></text>
    </view>
    <view class="menu-item">
      <text class="menu-label">关于</text>
      <text class="menu-value">></text>
    </view>
  </view>
</view>
