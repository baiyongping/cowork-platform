/* pages/opportunities/opportunities.wxss */
.container {
  min-height: 100vh;
  background: #F8F9FA;
  padding: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A202C;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #FF6B35;
  padding-left: 20rpx;
}

.opportunity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.opportunity-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border-left: 4rpx solid #F39C12;
}

.opportunity-content {
  flex: 1;
}

.opportunity-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A202C;
  margin-bottom: 12rpx;
}

.opportunity-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.opportunity-customer {
  color: #7A7E83;
}

.opportunity-amount {
  color: #FF6B35;
  font-weight: 600;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.opportunity-stage {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(243, 156, 18, 0.15);
  color: #F39C12;
  white-space: nowrap;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #B0B5BA;
}
