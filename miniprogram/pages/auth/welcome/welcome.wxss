.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 60rpx;
}

.logo image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 80rpx;
}

.auth-btn {
  width: 500rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: white;
  color: #667eea;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.tips {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
}
