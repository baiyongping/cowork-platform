.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.success-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 60rpx;
  animation: scaleIn 0.5s ease-out;
}

.success-icon image {
  width: 100%;
  height: 100%;
}

.success-title {
  font-size: 52rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
  animation: fadeInUp 0.6s ease-out 0.2s backwards;
}

.success-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 100rpx;
  animation: fadeInUp 0.6s ease-out 0.3s backwards;
}

.redirect-tips {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s ease-out 0.4s backwards;
}

.goto-btn {
  width: 500rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: white;
  color: #667eea;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  animation: fadeInUp 0.6s ease-out 0.5s backwards;
}

@keyframes scaleIn {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
