// 使用CloudBase SDK查询
async findWithCloudBase(filter: any) {
  const collection = this.cloudbaseService.collection('tasks');
  
  const { data } = await collection
    .where(filter)
    .orderBy('createdAt', 'desc')
    .limit(20)
    .get();
  
  return data;
}

// 使用CloudBase SDK事务
async createWithTransaction(taskDto: CreateTaskDto) {
  return this.cloudbaseService.runTransaction(async (transaction) => {
    // 事务操作
    await transaction.collection('tasks').add(taskDto);
    await transaction.collection('logs').add({
      action: '创建任务',
      createdAt: new Date(),
    });
  });
}
