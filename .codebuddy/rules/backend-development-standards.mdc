### Controller层规范

**示例: task.controller.ts**
```typescript
import { 
  Controller, Get, Post, Put, Delete, Param, Query, Body, 
  UseGuards, HttpCode, HttpStatus 
} from '@nestjs/common';
import { ApiTags, ApiOperation, ApiResponse, ApiBearerAuth } from '@nestjs/swagger';
import { TaskService } from './task.service';
import { CreateTaskDto } from './dto/create-task.dto';
import { UpdateTaskDto } from './dto/update-task.dto';
import { QueryTaskDto } from './dto/query-task.dto';
import { JwtAuthGuard } from '@/common/guards/auth.guard';
import { CurrentUser } from '@/common/decorators/current-user.decorator';
import { User } from '@/modules/user/user.entity';

@ApiTags('任务管理')
@ApiBearerAuth()
@Controller('tasks')
@UseGuards(JwtAuthGuard)
export class TaskController {
  constructor(private readonly taskService: TaskService) {}

  @Get()
  @ApiOperation({ summary: '获取任务列表' })
  @ApiResponse({ status: 200, description: '成功' })
  async findAll(@Query() query: QueryTaskDto, @CurrentUser() user: User) {
    return this.taskService.findAll(query, user);
  }

  @Get(':id')
  @ApiOperation({ summary: '获取任务详情' })
  @ApiResponse({ status: 200, description: '成功' })
  @ApiResponse({ status: 404, description: '任务不存在' })
  async findOne(@Param('id') id: string, @CurrentUser() user: User) {
    return this.taskService.findOne(id, user);
  }

  @Post()
  @ApiOperation({ summary: '创建任务' })
  @ApiResponse({ status: 201, description: '创建成功' })
  @ApiResponse({ status: 400, description: '参数错误' })
  @HttpCode(HttpStatus.CREATED)
  async create(@Body() dto: CreateTaskDto, @CurrentUser() user: User) {
    return this.taskService.create(dto, user);
  }

  @Put(':id')
  @ApiOperation({ summary: '更新任务' })
  @ApiResponse({ status: 200, description: '更新成功' })
  async update(
    @Param('id') id: string,
    @Body() dto: UpdateTaskDto,
    @CurrentUser() user: User,
  ) {
    return this.taskService.update(id, dto, user);
  }

  @Delete(':id')
  @ApiOperation({ summary: '删除任务' })
  @ApiResponse({ status: 204, description: '删除成功' })
  @HttpCode(HttpStatus.NO_CONTENT)
  async remove(@Param('id') id: string, @CurrentUser() user: User) {
    return this.taskService.remove(id, user);
  }
}
```

**Controller层规范要点**
- 使用装饰器清晰表达路由、HTTP方法、状态码
- 添加Swagger API文档注解
- 统一使用DTO进行参数验证
- 通过装饰器注入当前用户
- 不包含业务逻辑,只负责路由和参数处理

### Service层规范

**示例: task.service.ts**
```typescript
import { Injectable, NotFoundException, ForbiddenException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Task } from './task.entity';
import { CreateTaskDto } from './dto/create-task.dto';
import { UpdateTaskDto } from './dto/update-task.dto';
import { QueryTaskDto } from './dto/query-task.dto';
import { User } from '@/modules/user/user.entity';

@Injectable()
export class TaskService {
  constructor(
    @InjectRepository(Task)
    private readonly taskRepository: Repository<Task>,
  ) {}

  /**
   * 获取任务列表(支持分页和筛选)
   */
  async findAll(query: QueryTaskDto, user: User) {
    const { page = 1, limit = 20, level, status, keyword } = query;
    
    const queryBuilder = this.taskRepository.createQueryBuilder('task')
      .leftJoinAndSelect('task.owner', 'owner')
      .leftJoinAndSelect('task.collaborators', 'collaborators');

    // 权限过滤
    if (user.role !== 'admin') {
      queryBuilder.andWhere(
        '(task.ownerId = :userId OR task.isPublic = true)',
        { userId: user.id }
      );
    }

    // 筛选条件
    if (level && level !== 'all') {
      queryBuilder.andWhere('task.level = :level', { level });
    }
    if (status) {
      queryBuilder.andWhere('task.status = :status', { status });
    }
    if (keyword) {
      queryBuilder.andWhere(
        '(task.name LIKE :keyword OR owner.name LIKE :keyword)',
        { keyword: `%${keyword}%` }
      );
    }

    // 分页
    const [items, total] = await queryBuilder
      .skip((page - 1) * limit)
      .take(limit)
      .orderBy('task.createdAt', 'DESC')
      .getManyAndCount();

    return {
      total,
      page,
      limit,
      items,
    };
  }

  /**
   * 获取任务详情
   */
  async findOne(id: string, user: User) {
    const task = await this.taskRepository.findOne({
      where: { id },
      relations: ['owner', 'collaborators', 'comments', 'comments.user'],
    });

    if (!task) {
      throw new NotFoundException('任务不存在');
    }

    // 权限检查
    this.checkPermission(task, user);

    return task;
  }

  /**
   * 创建任务
   */
  async create(dto: CreateTaskDto, user: User) {
    const task = this.taskRepository.create({
      ...dto,
      owner: user,
      createdBy: user,
    });

    return this.taskRepository.save(task);
  }

  /**
   * 更新任务
   */
  async update(id: string, dto: UpdateTaskDto, user: User) {
    const task = await this.findOne(id, user);

    // 权限检查(只有负责人和管理员可编辑)
    if (task.owner.id !== user.id && user.role !== 'admin') {
      throw new ForbiddenException('无权编辑此任务');
    }

    Object.assign(task, dto);
    return this.taskRepository.save(task);
  }

  /**
   * 删除任务
   */
  async remove(id: string, user: User) {
    const task = await this.findOne(id, user);

    // 权限检查(只有管理员可删除)
    if (user.role !== 'admin') {
      throw new ForbiddenException('无权删除任务');
    }

    await this.taskRepository.remove(task);
  }

  /**
   * 检查任务访问权限
   */
  private checkPermission(task: Task, user: User) {
    const isOwner = task.owner.id === user.id;
    const isCollaborator = task.collaborators?.some(c => c.id === user.id);
    const isPublic = task.isPublic;
    const isAdmin = user.role === 'admin';

    if (!isOwner && !isCollaborator && !isPublic && !isAdmin) {
      throw new ForbiddenException('无权访问此任务');
    }
  }
}
```

**Service层规范要点**
- 包含核心业务逻辑
- 负责数据访问和处理
- 实施权限控制
- 处理业务异常
- 使用 session 实现事务 (MongoDB)
- 添加清晰的注释说明

**MongoDB Service示例**
```typescript
import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { Task } from './task.schema';

@Injectable()
export class TaskService {
  constructor(
    @InjectModel(Task.name)
    private taskModel: Model<Task>,
  ) {}

  async findAll(query: QueryTaskDto, user: User) {
    const { page = 1, limit = 20, level, status, keyword } = query;
    
    // 构建查询条件
    const filter: any = {};
    
    // 权限过滤
    if (user.role !== 'admin') {
      filter.$or = [
        { owner: user._id },
        { isPublic: true }
      ];
    }
    
    if (level && level !== 'all') {
      filter.level = level;
    }
    if (status) {
      filter.status = status;
    }
    if (keyword) {
      filter.name = { $regex: keyword, $options: 'i' };
    }
    
    // 查询数据
    const [items, total] = await Promise.all([
      this.taskModel
        .find(filter)
        .populate('owner', 'name email')
        .populate('collaborators', 'name email')
        .skip((page - 1) * limit)
        .limit(limit)
        .sort({ createdAt: -1 })
        .exec(),
      this.taskModel.countDocuments(filter),
    ]);
    
    return { total, page, limit, items };
  }

  async findOne(id: string, user: User) {
    const task = await this.taskModel
      .findById(id)
      .populate('owner', 'name email')
      .populate('collaborators', 'name email')
      .exec();
    
    if (!task) {
      throw new NotFoundException('任务不存在');
    }
    
    this.checkPermission(task, user);
    return task;
  }

  async create(dto: CreateTaskDto, user: User) {
    const task = new this.taskModel({
      ...dto,
      owner: user._id,
      createdBy: user._id,
    });
    
    return task.save();
  }
}
```

### Schema层规范 (Mongoose)

**示例: task.schema.ts**
```typescript
import { Prop, Schema, SchemaFactory } from '@nestjs/mongoose';
import { Document, Types } from 'mongoose';

export type TaskLevel = '公司级' | '团队级' | '个人级';
export type TaskType = '日常工作' | '商机跟进' | '项目任务';
export type TaskStatus = '未开始' | '进行中' | '已完成' | '延期' | '取消' | '暂停';

@Schema({ 
  collection: 'tasks',
  timestamps: true, // 自动创建 createdAt 和 updatedAt
  versionKey: false // 不使用 __v 字段
})
export class Task extends Document {
  @Prop({ required: true, maxlength: 255 })
  name: string;

  @Prop({ 
    required: true, 
    enum: ['公司级', '团队级', '个人级'],
    index: true 
  })
  level: TaskLevel;

  @Prop({ 
    required: true, 
    enum: ['日常工作', '商机跟进', '项目任务'] 
  })
  type: TaskType;

  @Prop({ required: true, index: true })
  status: TaskStatus;

  @Prop({ type: Number, default: 0, min: 0, max: 100 })
  progress: number;

  @Prop({ type: Types.ObjectId, ref: 'User', required: true, index: true })
  owner: Types.ObjectId;

  @Prop({ type: [{ type: Types.ObjectId, ref: 'User' }], default: [] })
  collaborators: Types.ObjectId[];

  @Prop({ maxlength: 100 })
  team?: string;

  @Prop({ required: true, type: Date })
  startDate: Date;

  @Prop({ required: true, type: Date, index: true })
  endDate: Date;

  @Prop()
  description?: string;

  @Prop({ default: true })
  isPublic: boolean;

  @Prop()
  opportunityActionType?: string;

  @Prop()
  projectPhase?: string;

  @Prop({ type: Types.ObjectId })
  relatedTo?: Types.ObjectId;

  @Prop({ type: Types.ObjectId, ref: 'User', required: true })
  createdBy: Types.ObjectId;

  // timestamps: true 会自动创建这两个字段
  createdAt: Date;
  updatedAt: Date;
}

export const TaskSchema = SchemaFactory.createForClass(Task);

// 创建复合索引
TaskSchema.index({ owner: 1, level: 1, status: 1 });
TaskSchema.index({ endDate: 1, status: 1 });

// 添加虚拟字段 (可选)
TaskSchema.virtual('comments', {
  ref: 'TaskComment',
  localField: '_id',
  foreignField: 'task',
});
```

**Schema层规范要点**
- 使用 @nestjs/mongoose 装饰器定义Schema
- 启用 timestamps 自动管理时间
- 使用 Types.ObjectId 定义关联关系
- 添加合理的索引优化查询
- 使用枚举类型限制字段值
- 支持虚拟字段 (populate)
- MongoDB的_id会自动生成

### DTO层规范

**示例: create-task.dto.ts**
```typescript
import { ApiProperty } from '@nestjs/swagger';
import { 
  IsNotEmpty, IsEnum, IsString, IsBoolean, IsInt, 
  IsDateString, IsOptional, Min, Max, MaxLength 
} from 'class-validator';
import { TaskLevel, TaskType, TaskStatus } from '../task.entity';

export class CreateTaskDto {
  @ApiProperty({ description: '任务名称', example: '拜访中国石油采购部门' })
  @IsNotEmpty({ message: '任务名称不能为空' })
  @IsString()
  @MaxLength(255, { message: '任务名称不能超过255个字符' })
  name: string;

  @ApiProperty({ description: '任务级别', enum: ['公司级', '团队级', '个人级'] })
  @IsEnum(['公司级', '团队级', '个人级'], { message: '任务级别无效' })
  level: TaskLevel;

  @ApiProperty({ description: '任务类型', enum: ['日常工作', '商机跟进', '项目任务'] })
  @IsEnum(['日常工作', '商机跟进', '项目任务'], { message: '任务类型无效' })
  type: TaskType;

  @ApiProperty({ description: '任务状态', example: '未开始' })
  @IsString()
  status: TaskStatus;

  @ApiProperty({ description: '完成进度', example: 0, minimum: 0, maximum: 100 })
  @IsInt({ message: '进度必须是整数' })
  @Min(0, { message: '进度不能小于0' })
  @Max(100, { message: '进度不能大于100' })
  progress: number;

  @ApiProperty({ description: '协同人ID数组', required: false })
  @IsOptional()
  @IsString({ each: true })
  collaborators?: string[];

  @ApiProperty({ description: '所属团队', required: false })
  @IsOptional()
  @IsString()
  @MaxLength(100)
  team?: string;

  @ApiProperty({ description: '开始日期', example: '2025-12-01' })
  @IsDateString({}, { message: '开始日期格式无效' })
  startDate: string;

  @ApiProperty({ description: '截止日期', example: '2025-12-05' })
  @IsDateString({}, { message: '截止日期格式无效' })
  endDate: string;

  @ApiProperty({ description: '任务描述', required: false })
  @IsOptional()
  @IsString()
  description?: string;

  @ApiProperty({ description: '是否公开', default: true })
  @IsOptional()
  @IsBoolean()
  isPublic?: boolean;

  @ApiProperty({ description: '商机跟进动作类型', required: false })
  @IsOptional()
  @IsString()
  opportunityActionType?: string;

  @ApiProperty({ description: '项目任务环节', required: false })
  @IsOptional()
  @IsString()
  projectPhase?: string;

  @ApiProperty({ description: '关联内容ID', required: false })
  @IsOptional()
  @IsString()
  relatedTo?: string;
}
```

**DTO层规范要点**
- 使用class-validator进行参数验证
- 添加Swagger文档注解
- 提供清晰的错误提示信息
- 区分必填和可选字段
- 使用枚举限制字段值

## MongoDB数据库规范

### 集合命名规范

**集合名**: 小写复数名词,使用驼峰命名
```
✓ tasks
✓ taskComments
✓ opportunities
✓ users
✗ Task (避免大写)
✗ task_comments (MongoDB推荐驼峰而非下划线)
```

**字段名**: 使用驼峰命名
```
✓ createdAt
✓ ownerId
✓ isPublic
✗ created_at (MongoDB推荐驼峰)
✗ owner_id
```

### 索引规范

**创建索引示例**
```typescript
// 在 Schema 定义中创建索引
@Prop({ index: true })
ownerId: string;

// 复合索引
TaskSchema.index({ owner: 1, level: 1, status: 1 });
TaskSchema.index({ endDate: 1, status: 1 });

// 唯一索引
@Prop({ unique: true })
email: string;

// 文本索引 (用于全文搜索)
TaskSchema.index({ name: 'text', description: 'text' });
```

**索引最佳实践**
- 为常用查询字段创建索引
- 复合索引按查询频率排序
- 避免过多索引影响写入性能
- 定期分析慢查询优化索引

### Schema设计最佳实践

**1. 嵌入式文档 vs 引用**
```typescript
// 嵌入式 - 适合一对一、一对少量
@Prop({
  type: {
    name: String,
    phone: String,
    email: String
  }
})
contact: {
  name: string;
  phone: string;
  email: string;
};

// 引用 - 适合一对多、多对多
@Prop({ type: Types.ObjectId, ref: 'User' })
owner: Types.ObjectId;

@Prop({ type: [{ type: Types.ObjectId, ref: 'User' }] })
collaborators: Types.ObjectId[];
```

**2. 使用 timestamps**
```typescript
@Schema({ timestamps: true })
export class Task extends Document {
  // 自动生成 createdAt 和 updatedAt
}
```

**3. 字段验证**
```typescript
@Prop({ 
  required: true,
  minlength: 1,
  maxlength: 255,
  trim: true
})
name: string;

@Prop({ 
  type: Number,
  min: 0,
  max: 100,
  default: 0
})
progress: number;
```

### MongoDB查询优化规范

**1. 使用索引**
```typescript
// 为常用查询字段添加索引
TaskSchema.index({ owner: 1, status: 1 });
TaskSchema.index({ level: 1, endDate: 1 });
```

**2. 使用 populate 避免N+1查询**
```typescript
// ❌ 避免
const tasks = await this.taskModel.find();
for (const task of tasks) {
  task.owner = await this.userModel.findById(task.owner);
}

// ✓ 使用 populate
const tasks = await this.taskModel
  .find()
  .populate('owner', 'name email')
  .populate('collaborators', 'name email')
  .exec();
```

**3. 分页查询**
```typescript
// 使用 skip 和 limit 实现分页
const [items, total] = await Promise.all([
  this.taskModel
    .find(filter)
    .skip((page - 1) * limit)
    .limit(limit)
    .exec(),
  this.taskModel.countDocuments(filter),
]);
```

**4. 聚合管道处理复杂查询**
```typescript
const result = await this.taskModel.aggregate([
  // 筛选
  { $match: { level: '公司级', status: '进行中' } },
  // 关联
  { 
    $lookup: {
      from: 'users',
      localField: 'owner',
      foreignField: '_id',
      as: 'ownerInfo'
    }
  },
  // 展开
  { $unwind: '$ownerInfo' },
  // 分组统计
  {
    $group: {
      _id: '$status',
      count: { $sum: 1 },
      avgProgress: { $avg: '$progress' }
    }
  },
  // 排序
  { $sort: { count: -1 } }
]);
```

**5. 投影优化 (只查询需要的字段)**
```typescript
// 只返回需要的字段
